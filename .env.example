APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI Provider — set AI_PROVIDER to: fireworks | gemini | openai | anthropic | ollama
AI_PROVIDER=fireworks

# Fireworks AI (Meta Llama open-weights — required for Meta hackathon eligibility)
# Get your key at: https://fireworks.ai/account/api-keys
# Models: accounts/fireworks/models/llama-v3p3-70b-instruct (default, recommended)
#         accounts/fireworks/models/llama-v3p1-8b-instruct  (faster, lower cost)
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
FIREWORKS_URL=https://api.fireworks.ai/inference/v1

# Prism PHP — Laravel AI SDK (composer require prism-php/prism)
# Used exclusively by the conversational bot (BotPrismService)
# All other AI services still use AiGatewayService above
# After installing: php artisan vendor:publish --tag=prism-config
# Then add to config/prism.php providers block:
#   'fireworks' => ['driver' => 'openai', 'url' => env('FIREWORKS_URL'), 'api_key' => env('FIREWORKS_API_KEY')]
PRISM_BOT_PROVIDER=fireworks
PRISM_BOT_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# Gemini API (fallback)
GEMINI_API_KEY=your_gemini_api_key_here
STRANDS_MODEL_ID=gemini-2.5-flash

# Laravel Backend
LARAVEL_API_URL=http://localhost:8000/api
LARAVEL_API_KEY=your_api_key_here

# Agent Settings
BRAND_ID=1
BRAND_NAME=MyBrand
AGENT_INTERVAL=900          # Run every 15 minutes
HEALTH_CHECK_INTERVAL=3600  # Health check every hour

# Rate Limits
MAX_ACTIONS_PER_HOUR=20
MAX_CONTENT_PER_DAY=5

# Logging
LOG_LEVEL=info

# Ad platforms (agent can pause/resume/adjust budgets after human approval)
META_ADS_ACCESS_TOKEN=
META_ADS_API_VERSION=v21.0
META_ADS_CURRENCY_OFFSET=100
# Meta organic (Pages + Instagram). The same token can serve ads and organic if it has the scopes.
# Needs: pages_show_list, pages_read_engagement, read_insights, pages_manage_posts,
#        instagram_basic, instagram_manage_insights, instagram_content_publish
META_ACCESS_TOKEN=
META_API_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_INSTAGRAM_ID=
# Auto-publishing stays OFF until you set this to true; every post still needs a human to approve it.
META_PUBLISHING_ENABLED=false
META_MAX_POSTS_PER_DAY=5
AD_MAX_BUDGET_CHANGE=0.25
META_AD_ACCOUNT_ID=
META_AUDIENCE_COUNTRIES=KE

# Optional: web search for competitor discovery (free tier, no card). Get a key at tavily.com
TAVILY_API_KEY=
